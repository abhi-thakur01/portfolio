# Contact form: all six settings are required by the server-side /api/contact.
# Never prefix secrets with VITE_ or put them in frontend code.
# Create a sending API key and verify the sender domain at https://resend.com.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxx
CONTACT_TO_EMAIL=thakurabhi8925@gmail.com
CONTACT_FROM_EMAIL=portfolio@abhishekthakur.in
CONTACT_ALLOWED_ORIGIN=https://abhi-thakur-web.vercel.app

# Shared rate limiting: copy the HTTPS REST URL and read/write token from Upstash.
# Missing/unavailable Redis blocks sending; there is no per-instance fallback.
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token

# GitHub OAuth and CMS publishing:
# GITHUB_REPO defaults to abhi-thakur01/portfolio if omitted.
# GITHUB_BRANCH should match the portfolio deployment branch, commonly main.
GITHUB_OAUTH_CLIENT_ID=your_github_oauth_app_client_id
GITHUB_OAUTH_CLIENT_SECRET=your_github_oauth_app_client_secret
CMS_SESSION_SECRET=generate_a_long_random_server_only_secret
CMS_GITHUB_USERNAME=your_authorized_github_username
GITHUB_REPO=abhi-thakur01/portfolio
GITHUB_BRANCH=main

# Configure in Vercel's server-side environment settings; do not commit real values.
# For local API testing use Vercel dev and set CONTACT_ALLOWED_ORIGIN to the
# exact local origin (for example http://localhost:3000), without a trailing slash.
